# Cambia TU_CLAVE por la contraseña que pusiste al instalar PostgreSQL
# (usa solo letras y números para evitar problemas)
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/pasarela

# Modo de reserva:
#   sala     -> con sala de espera + reserva atómica (versión final)
#   directo  -> sin sala de espera, bloqueo con SELECT ... FOR UPDATE (para comparar el trade-off)
#   inseguro -> sin control de concurrencia (solo para demostrar la sobreventa)
MODO_RESERVA=sala

# Sala de espera: cuántos usuarios entran por segundo
SALA_ADMITIDOS_POR_SEG=50

# Antibots: límite de peticiones por IP (poner 0 para las pruebas de carga)
ANTIBOTS=1
LIMITE_PETICIONES=60
VENTANA_SEGUNDOS=10

# Clave para firmar los pases de la sala y los códigos QR de las entradas.
# Debe ser fija: si cambia, los QR ya emitidos dejan de validar.
SECRETO=cambia-esto-por-una-cadena-larga-y-aleatoria

# Clave del panel de administrador (http://127.0.0.1:8000/admin.html)
ADMIN_CLAVE=cambia-esta-clave
